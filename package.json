{
  "name": "pranova-backend",
  "version": "1.0.0",
  "description": "PRANOVA Healthcare Coordination Platform - API Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --include .env src/server.ts",
    "install:all": "npm install && npm --prefix admin-web install",
    "build:server": "node src/scripts/build-prisma.js && tsc",
    "build:admin": "npm --prefix admin-web run build",
    "build": "node src/scripts/build-prisma.js && tsc && npm --prefix admin-web run build",
    "start": "node src/scripts/start-production.js",
    "postinstall": "node src/scripts/build-prisma.js",
    "prisma:generate": "tsx src/scripts/prisma-cli.ts generate",
    "prisma:migrate": "tsx src/scripts/prisma-cli.ts migrate dev",
    "prisma:deploy": "tsx src/scripts/prisma-cli.ts migrate deploy",
    "prisma:studio": "tsx src/scripts/prisma-cli.ts studio",
    "prisma:push": "tsx src/scripts/prisma-cli.ts db push",
    "seed": "tsx prisma/seed.ts",
    "db:import": "tsx src/scripts/import_data.ts",
    "generate:swagger": "tsx src/scripts/generate-swagger.ts",
    "generate:guide": "python src/scripts/generate_user_guide.py"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.4.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
