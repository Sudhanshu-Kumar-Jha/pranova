# ==============================================================================
# PRANOVA HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Application Environment: 'production' for live/cloud deployments, 'development' for local coding
NODE_ENV=production
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:5000
APP_TIMEZONE=Asia/Kolkata
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8 / MariaDB)
# You can provide discrete credentials or a unified DATABASE_URL / MYSQL_URL
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pranova_db
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# Optional unified connection URL (Takes precedence or used in Railway/Cloud):
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/pranova_db"

# ------------------------------------------------------------------------------
# 3. SUPER ADMINISTRATOR BOOTSTRAP CREDENTIALS
# Automatically initialized and synced on server startup
# ------------------------------------------------------------------------------
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@pranova.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=+919876500000
ADMIN_DEPARTMENT=Operations

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=pranova_super_secret_jwt_access_token_key_2026_healthcare
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=pranova_super_secret_jwt_refresh_token_key_2026_healthcare
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
ADMIN_WEB_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. SWAGGER / OPENAPI DOCUMENTATION
# ------------------------------------------------------------------------------
ENABLE_SWAGGER=true
SWAGGER_URL=http://localhost:5000/api-docs

# ------------------------------------------------------------------------------
# 7. FRONTEND ADMIN WEB (VITE) ENVIRONMENT
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
