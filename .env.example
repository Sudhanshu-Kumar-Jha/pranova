# ==============================================================================
# PRANOVA HEALTHCARE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT (PRODUCTION)
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
APP_DEBUG=false
# Production Application URL (Domain or Railway Slug without trailing slash)
APP_URL=https://your-production-app.up.railway.app
APP_TIMEZONE=Asia/Kolkata
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8 / MariaDB)
# Provide discrete parameters or a unified DATABASE_URL / MYSQL_URL
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pranova_db
DB_USERNAME=root
DB_PASSWORD=YOUR_PRODUCTION_MYSQL_PASSWORD

# Optional unified connection URL (Used in Railway / Cloud Deployments):
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/pranova_db"

# ------------------------------------------------------------------------------
# 3. SUPER ADMINISTRATOR BOOTSTRAP CREDENTIALS
# Automatically verified and initialized on production startup
# ------------------------------------------------------------------------------
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@pranova.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=+919876500000
ADMIN_DEPARTMENT=Operations

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT)
# Generate secure 32+ character secrets for production
# ------------------------------------------------------------------------------
JWT_SECRET=pranova_super_secret_jwt_access_token_key_2026_healthcare
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=pranova_super_secret_jwt_refresh_token_key_2026_healthcare
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGIN=*
ADMIN_WEB_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 6. SWAGGER / OPENAPI SPECIFICATION
# Set to 'false' if you wish to disable the interactive documentation endpoint
# ------------------------------------------------------------------------------
ENABLE_SWAGGER=true
SWAGGER_URL=http://localhost:5000/api-docs

# ------------------------------------------------------------------------------
# 7. FRONTEND ADMIN WEB CONFIGURATION
# In production, relative paths dynamically target the host domain
# ------------------------------------------------------------------------------
VITE_API_URL=/api/v1
VITE_SOCKET_URL=/
